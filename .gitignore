*.pdf
*.mp3
*.flac
*.wav
*.m4a
*.aac
*.ogg
*.opus
*.wma
*.zip
*.tar.bz2
*.pem
*.key
*.p12
*.pfx
*.kdbx
id_rsa*
.env
.env.*
secrets.*
*.log

# Website data is generated by `bbc6 site` on every build
/public/
/site/data/
