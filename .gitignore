# Build output
/target/

# Working data that is regenerated or private to your machine
/data/_cache/
/data/_mbcache/
/data/playlists/
/data/plays/*.csv        # freshly scraped plays; gzip + `git add -f` to publish them deliberately
/data/spotify_import.csv

